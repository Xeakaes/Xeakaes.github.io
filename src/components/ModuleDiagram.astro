<style>
  .mod { margin: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .box { border: 1px solid var(--boundary); padding: .85rem .9rem; display: flex; flex-direction: column; gap: .25rem; min-width: 0; }
  b { font: 500 1rem/1.3 var(--f-display); }
  span { font: 400 .75rem/1.6 var(--f-mono); color: var(--muted); }
  .core { background: var(--text); border-color: var(--text); color: var(--bg); }
  .core span { color: var(--bg); }
  .join { height: 1.5rem; width: 50%; margin-inline: auto; border-inline: 1px solid var(--accent); }
  figcaption { margin-top: .85rem; }
</style>
