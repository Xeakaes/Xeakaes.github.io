---
const rows = [
  { label: 'Default placement', chain: [['Render', 's'], ['DLSS upscale', 'l'], ['NR', 'nr l']] },
  { label: 'This add-on', chain: [['Render', 's'], ['NR', 'nr s'], ['DLSS upscale', 'l']] },
];
---
<figure class="pre">
  {rows.map((r) => (
    <div class="r">
      <p class="meta">{r.label}</p>
      <ol aria-label={r.label}>{r.chain.map(([t, c]) => <li class={c}>{t}</li>)}</ol>
    </div>
  ))}
  <figcaption class="meta">Diagram: where Neural Rendering (NR) runs. Short blocks work on the render-resolution image. Not to scale, not a benchmark.</figcaption>
</figure>
<style>
  .pre { margin: 0; display: grid; gap: 1.5rem; }
  .r p { margin: 0 0 .5rem; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; align-items: center; }
  li { position: relative; border: 1px solid var(--boundary); min-height: 5.75rem; display: grid; place-items: center; text-align: center; padding: .5rem; font: 500 .9375rem/1.25 var(--f-display); }
  li.s { min-height: 3.5rem; }
  li + li::before { content: '→'; position: absolute; left: -1.05rem; color: var(--muted); }
  .nr { border: 2px solid var(--accent); }
</style>
