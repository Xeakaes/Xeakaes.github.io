---
const stages = [
  { n: 'Perception', items: ['OCR text', 'Frames and live stream', 'Text-only screen diff'] },
  { n: 'Decision', items: ['Made by the connected agent', 'Not part of this project'], outside: true },
  { n: 'Safety gates', items: ['Auth token', 'Focus guard', 'Blocked key combos', 'Protected processes'], gate: true },
  { n: 'Action', items: ['Mouse and keyboard', 'Windows', 'Virtual desktops (Windows)'] },
];
---
<figure class="gates">
  <ol>
    {stages.map((s) => (
      <li class:list={{ outside: s.outside, gate: s.gate }}>
        <span class="name">{s.n}</span>
        <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
      </li>
    ))}
  </ol>
  <figcaption class="meta">Diagram: the server perceives and acts; every action passes its safety checks. A held-key watchdog releases stuck input.</figcaption>
</figure>
<style>
  .gates { margin: 0; container-type: inline-size; }
  ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.75rem; }
  ol > li { position: relative; display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: .85rem 1rem; border: 1px solid var(--boundary); }
  ol > li:not(:last-child)::after { content: '↓'; position: absolute; left: 1rem; bottom: -1.7rem; line-height: 1.6; color: var(--accent-ink); }
  .outside { border-style: dashed; color: var(--muted); }
  /* the gate is the one heavy, striped element: everything passes through it */
  ol > li.gate { border: 2px solid var(--accent); padding-top: 1.35rem; background: repeating-linear-gradient(135deg, var(--accent) 0 3px, transparent 3px 9px) top / 100% .6rem no-repeat; }
  .name { font: 500 1rem/1.5 var(--f-display); }
  ul { list-style: none; margin: 0; padding: 0; font: 400 .75rem/1.9 var(--f-mono); }
  figcaption { margin-top: .85rem; }
  @container (min-width: 40rem) {
    ol { grid-template-columns: repeat(4, 1fr); }
    ol > li { grid-template-columns: 1fr; align-content: start; gap: .75rem; min-height: 13rem; padding-top: 1.35rem; }
    ol > li:not(:last-child)::after { content: '→'; left: auto; right: -1.4rem; bottom: auto; top: 1.4rem; }
  }
  @container (max-width: 22rem) { ol > li { grid-template-columns: 1fr; gap: .35rem; } }
</style>
