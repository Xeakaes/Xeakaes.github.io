---
import type { CollectionEntry } from 'astro:content';
import GateDiagram from './GateDiagram.astro';
import VoxelDiagram from './VoxelDiagram.astro';
import ModuleDiagram from './ModuleDiagram.astro';
import { url } from '../scripts/url';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const diagrams: Record<string, any> = { 'screen-control': GateDiagram, 'aerovision-cfd': VoxelDiagram, nexadesk: ModuleDiagram };
---
<div class="grid three">
  {projects.map((p) => {
    const Diagram = diagrams[p.id];
    return (
      <article class:list={['item', `item--${p.id}`]} data-reveal aria-labelledby={`t-${p.id}`}>
        {Diagram && <div class="fig" style={`view-transition-name: fig-${p.id}`}><Diagram /></div>}
        <div class="text">
          <h3 id={`t-${p.id}`}><a href={url(`work/${p.id}/`)}>{p.data.title}</a></h3>
          <p>{p.data.summary}</p>
          <ul class="tags">{p.data.technologies.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
          <a class="textlink" href={url(`work/${p.id}/`)}>Case study<span class="sr">: {p.data.title}</span> <span aria-hidden="true">→</span></a>
        </div>
      </article>
    );
  })}
</div>
<style>
  .three { margin-top: var(--section); row-gap: clamp(4rem, 8vw, 7rem); align-items: start; }
  .item { border-top: 1px solid var(--text); padding-top: 1.5rem; display: grid; gap: 1.75rem; min-width: 0; }
  .item > * { min-width: 0; }
  h3 { margin-bottom: .75rem; }
  h3 a { color: var(--text); text-decoration: none; display: inline-block; min-height: 44px; padding-block: .4rem; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  .text .tags { margin: 1rem 0 .5rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 62rem) {
    .item--screen-control { grid-column: 1 / span 7; }
    .item--aerovision-cfd { grid-column: 9 / span 4; margin-top: 7rem; }
    .item--aerovision-cfd .text { order: -1; }
    .item--nexadesk { grid-column: 2 / span 11; grid-template-columns: 5fr 6fr; gap: calc(var(--col-gap) * 2); }
    .item--nexadesk .fig { order: 2; }
  }
</style>
