---
import type { CollectionEntry } from 'astro:content';
import DataFlow from './DataFlow.astro';
import ProductStage from './ProductStage.astro';
import { url } from '../scripts/url';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
const href = url(`work/${project.id}/`);
const features = [
  ['Live readings', 'CPU, GPU, integrated GPU, RAM, disk, network, fans and FPS, with live charts and one hour of local history.'],
  ['A dashboard you arrange', 'Color palettes, custom backgrounds, a dashboard edit mode and a landscape layout.'],
  ['More than one PC', 'Switch between computers with tabs. A persistent notification keeps the active one in view.'],
  ['Quick, token-gated setup', 'Scan a QR code or enter IP, port and token by hand. The server requires an access token.'],
  ['Local-first', 'No user account and no required cloud service. TLS and Cloudflare Tunnel are there if you choose them.'],
  ['In your language', 'A multilingual interface, built with Kotlin, Jetpack Compose and Material 3.'],
];
---
<article class="featured" aria-labelledby="featured-title">
  <header class="grid head">
    <h3 id="featured-title"><a href={href}>{d.title}</a></h3>
    <p class="lead">{d.summary}</p>
  </header>
  <ProductStage href={href} />
  <div class="grid body">
    <div class="overview" data-reveal>
      <p>A small server on a Windows PC reads the hardware sensors and sends them to an Android app. It is released on Google Play and F-Droid, and the source is open under {d.license}.</p>
      <p class="muted">The real-data server runs on Windows only.</p>
      <ul class="linkrow links">
        {d.links.map((l) => <li><a class="textlink" href={l.href}>{l.label} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
      <p class="meta">Featured in <a href="https://androidweekly.net/issues/issue-739">Android Weekly #739</a>.</p>
    </div>
    <dl class="features" data-reveal>
      {features.map(([t, x]) => (<div><dt>{t}</dt><dd>{x}</dd></div>))}
    </dl>
  </div>
  <div class="arch" data-reveal>
    <h4>Architecture</h4>
    <DataFlow />
  </div>
  <p class="cta"><a class="btn btn--solid" href={href}>Read the {d.title} case study <span aria-hidden="true">→</span></a></p>
</article>
<style>
  .head { row-gap: 1rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  h3 { font-size: var(--t-h1); line-height: .98; letter-spacing: -.04em; }
  h3 a { color: inherit; text-decoration: none; display: inline-block; padding-block: .1em; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; }
  .head p { margin: 0; }
  .body { margin-top: clamp(2.5rem, 5vw, 4.5rem); row-gap: 3rem; }
  .links { margin: 1.25rem 0 .75rem; }
  .features { margin: 0; display: grid; gap: 0 var(--col-gap); }
  .features div { border-top: 1px solid var(--rule); padding: 1rem 0 1.25rem; }
  dt { font: 500 1.125rem/1.3 var(--f-display); margin-bottom: .35rem; }
  dd { margin: 0; color: var(--muted); font-size: .9688rem; line-height: 1.6; }
  .arch { margin-top: clamp(3rem, 6vw, 5rem); }
  h4 { margin-bottom: 1.25rem; }
  .cta { margin: 2.5rem 0 0; }
  .cta a { text-wrap: balance; }
  @media (min-width: 38rem) { .features { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 56rem) {
    h3 { grid-column: 1 / span 7; white-space: nowrap; }
    .head p { grid-column: 8 / span 5; }
    .overview { grid-column: 1 / span 4; }
    .features { grid-column: 6 / span 7; }
  }
</style>
